Program 8.2 — Life cycle in four lines of printing (16 lines)
// Ex 8(a): watch the order of the life-cycle methods on the console
import java.applet.Applet;
import java.awt.Graphics;
public class LifeCycle extends Applet {
public void init() { System.out.println("init()"); }
public void start() { System.out.println("start()"); }
public void stop() { System.out.println("stop()"); }
public void destroy() { System.out.println("destroy()"); }
public void paint(Graphics g) {
System.out.println("paint()");
g.drawString("Minimise and restore this window", 20, 30);
}
}
Console output
init()
start()
paint()
stop() <- window minimised
start() <- window restored
paint()
stop() <- window closed
destroy()
8(b) Colour Palette
Program 8.3 — Palette.java (25 lines)
// Ex 8(b): click a colour box, the big box below changes
import java.applet.Applet;
import java.awt.*;
import java.awt.event.*;
public class Palette extends Applet {
Color[] c = { Color.RED, Color.GREEN, Color.BLUE, Color.YELLOW };
int sel = 0;
public void init() {
addMouseListener(new MouseAdapter() {
public void mouseClicked(MouseEvent e) {
int i = (e.getX() - 20) / 60;
if (e.getY() < 60 && i >= 0 && i < 4) sel = i;
repaint();
}
});
}
public void paint(Graphics g) {
for (int i = 0; i < c.length; i++) {
g.setColor(c[i]);
g.fillRect(20 + i * 60, 20, 50, 40);
}
g.setColor(c[sel]);
g.fillRect(20, 90, 230, 60);
}
}
